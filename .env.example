# Plantilla de variables de entorno — copiar como .env.local y completar con los valores reales.
# El .env.local NUNCA se sube a GitHub; pedir los valores al dueño del proyecto por canal privado.

# ── Supabase (obligatorio — sin esto la app no parte) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio: acceso total a la BD. Solo para gente de confianza.
SUPABASE_SERVICE_ROLE_KEY=

# ── Autodesk Platform Services (visor 3D Forge) ───────────────────────────────
AUTODESK_CLIENT_ID=
AUTODESK_CLIENT_SECRET=
AUTODESK_CALLBACK_URL=http://localhost:3000/api/autodesk/callback

# ── PDFs locales de Aconex (opcional) ─────────────────────────────────────────
# Una o varias carpetas separadas por ";". Los links de planos/documentos abren
# archivos de ESTAS carpetas — en otro PC hay que apuntar a sus propias copias.
ACONEX_DOCS_DIR=
